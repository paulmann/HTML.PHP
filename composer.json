{
    "name": "paulmann/html-php",
    "description": "Production template engine + Apache SSI processor + gettext i18n for PHP 8.3+. Zero dependencies. WordPress bridge included.",
    "type": "library",
    "license": "MIT",
    "keywords": ["template", "ssi", "i18n", "gettext", "wordpress", "escaping", "lint"],
    "authors": [
        {
            "name": "Mikhail Deynekin",
            "email": "Mikhail@Deynekin.com",
            "homepage": "https://Deynekin.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "conflict": {
        "paulmann/html-php85": "*"
    },
    "suggest": {
        "ext-mbstring": "Multibyte-correct truncation, casing and slugs",
        "ext-intl": "Higher-quality transliteration in Str::slugify()",
        "ext-apcu": "Enables the apcu render-cache driver"
    },
    "autoload": {
        "psr-4": {
            "HtmlPhp\\": "src/"
        }
    },
    "bin": [
        "bin/htmlphp"
    ],
    "scripts": {
        "test": "php tests/run.php",
        "test85": "php8.5 tests/run.php",
        "build": "php tools/build.php",
        "matrix": "bash tools/run-matrix.sh",
        "bench": "php tools/bench.php"
    },
    "config": {
        "sort-packages": true
    }
}
