{
    "name": "paulmann/html-php",
    "description": "Single-file PHP 8.3+ template engine: Apache SSI directives, i18n (PO/MO, plural forms), loops, filters, render cache, html4.pl-compatible legacy API, WordPress bridge \u2014 zero dependencies.",
    "type": "library",
    "keywords": [
        "template",
        "ssi",
        "i18n",
        "gettext",
        "wordpress",
        "html4.pl",
        "single-file"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mikhail Deynekin",
            "email": "Mikhail@Deynekin.com",
            "homepage": "https://Deynekin.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "files": [
            "html.php"
        ]
    },
    "scripts": {
        "test": "php ../tests/run-tests.php --lib=html.php"
    },
    "config": {
        "sort-packages": true
    }
}
